  "forbidden": [
    "sessions",
    "hook-receipts",
    "plugins",
    "connections",
    "models_cache.json",
    ".env",
    "token",
    "credential",
    "prompt",
    "transcript"
  ],
  "package": "codex-governance-infra",
  "privacy": {
    "allowed_placeholders": [
      {
        "id": "user",
        "scope": "exact-value",
        "value": "<user>"
      },
      {
        "id": "isolated-temp",
        "scope": "exact-value",
        "value": "<isolated-temp>"
      },
      {
        "id": "home",
        "scope": "exact-value",
        "value": "${HOME}"
      },
      {
        "id": "home-short",
        "scope": "exact-value",
        "value": "$HOME"
      },
      {
        "id": "codex-home",
        "scope": "exact-value",
        "value": "${CODEX_HOME}"
      },
      {
        "id": "codex-home-short",
        "scope": "exact-value",
        "value": "$CODEX_HOME"
      },
      {
        "id": "domain",
        "scope": "exact-value",
        "value": "example.invalid"
      },
      {
        "id": "synthetic-token",
        "scope": "exact-value",
        "value": "synthetic-token"
      },
      {
        "id": "synthetic-id",
        "scope": "exact-value",
        "value": "<synthetic-id>"
      },
      {
        "id": "session-example",
        "scope": "exact-value",
        "value": "session-secret-123"
      },
      {
        "id": "turn-example",
        "scope": "exact-value",
        "value": "turn-secret-456"
      },
      {
        "id": "runtime-example",
        "scope": "exact-value",
        "value": "runtime-id"
      }
    ],
    "rule_ids": [
      "credential-value",
      "forbidden-filename",
      "non-utf8",
      "private-path",
      "runtime-identifier",
      "symlink",
      "temp-artifact"
    ],
    "rules": [
      {
        "class": "credential",
        "id": "credential-value",
        "mandatory": true,
        "pattern": "(?i)\\b(?:assigned[_ -]?credential|credential|token|secret|password)\\s*[:=]\\s*[\\\"\\']?[^\\s,}\\\"\\']+",
        "semantics": "literal-assignment-value"
      },
      {
        "class": "runtime-id",
        "id": "runtime-identifier",
        "mandatory": true,
        "pattern": "(?i)\\b(?:session_id|turn_id|prompt_id|transcript_id|receipt_id)\\b\\s*[:=]\\s*[^\\n]+",
        "semantics": "literal-json-yaml-or-unquoted-value"
      },
      {
        "class": "path",
        "id": "private-path",
        "mandatory": true,
        "pattern": "(?:\\\\x2f|/)(?:home|Users|private|var[/\\\\]tmp)(?:\\\\x2f|/)[A-Za-z0-9._~-]+",
        "semantics": "portable-linux-macos-windows-raw-or-escaped"
      },
      {
        "class": "filename",
        "id": "forbidden-filename",
        "mandatory": true,
        "pattern": "decorated-session-receipt-prompt-transcript-credential-token-secret-password",
        "semantics": "path-token-boundary"
      },
      {
        "class": "encoding",
        "id": "non-utf8",
        "mandatory": true,
        "pattern": "utf-8",
        "semantics": "decode-strict"
      },
      {
        "class": "filesystem",
        "id": "symlink",
        "mandatory": true,
        "pattern": "symlink",
        "semantics": "lstat-no-follow"
      },
      {
        "class": "path",
        "id": "temp-artifact",
        "mandatory": true,
        "pattern": "(?:\\\\x2f|/)tmp(?:\\\\x2f|/)",
        "semantics": "tracked-temporary-artifact-path"
      }
    ],
    "schema": "privacy-rules.v1"
  },
  "schema_version": "1",
  "version": "15.0.0"
}
