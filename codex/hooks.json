{
  "description": "V16 task-routed tool readiness, usage evidence, and one-shot completion enforcement.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/hooks/session_context.py\"",
            "statusMessage": "Loading V16 governance",
            "additionalContextLimit": 1600,
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/hooks/session_context.py\"",
            "statusMessage": "Loading V16 subagent contract",
            "additionalContextLimit": 1600,
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/hooks/session_context.py\"",
            "statusMessage": "Binding V16 task intake",
            "additionalContextLimit": 1600,
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/hooks/pre_tool_use_policy.py\"",
            "statusMessage": "Checking V16 tool policy",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/hooks/post_tool_use_receipt.py\"",
            "statusMessage": "Recording V16 tool evidence",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/hooks/stop_tool_enforcement.py\"",
            "statusMessage": "Checking V16 completion evidence",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
