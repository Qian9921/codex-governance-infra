{
  "version": "16.0.0",
  "session_start": "session_context.py",
  "pre_tool_use": "pre_tool_use_policy.py",
  "receipt": "hook_receipt.py",
  "additional_context_limit": 1200,
  "spawn_observable": true,
  "spawn_enforcement": "parent-pre-dispatch+subagent-lock+post-result+dispatch-transcript",
  "tool_routing": {
    "known_structure": "codegraph",
    "semantic_discovery": "semble",
    "shell_context_output": "rtk",
    "exact_text": "rg",
    "fallback_requires": ["preferred_attempt", "reason_code", "evidence_ref"],
    "semantic_inference": "brief-declared-not-blanket-denied"
  }
}
