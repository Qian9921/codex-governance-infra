    "evidence-envelope.v16": {
      "validator": "evidence.validate_envelope",
      "validation_mode": "caller-bound",
      "required": [
        "schema",
        "mission_id",
        "head_sha",
        "tree_sha",
        "identity_mode",
        "snapshot_sha256",
        "clean",
