      "optional": [],
      "approval_required": [
        "approved_review_artifact_sha256",
        "approved_review_packet_sha256"
      ],
      "policy_binding": [
        "required_stages",
        "reviewer_model",
        "reasoning_effort",
        "review_risk",
        "reviewer_route",
        "classifier_identity",
        "high_risk_triggers",
        "review_policy_sha256",
        "identity_mode",
        "snapshot_sha256",
        "prior_snapshot_sha256",
        "delta_sha256"
      ],
      "external_inputs": [
        "validated review packet",
        "validated independent-review.v16 artifact",
        "dispatch lineage"
      ]
